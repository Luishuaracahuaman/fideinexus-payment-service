	},
	"item": [
		{
			"name": "1. Creación de Pagos (Driving)",
			"item": [
				{
					"name": "Crear Pago por Solicitud (Sacramento)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"tenant_id\": 1,\n  \"persona_id\": 101,\n  \"request_id\": 501,\n  \"amount\": 50.00\n}"
						},
						"url": {
							"raw": "{{base_url}}/payments",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"payments"
							]
						},
						"description": "Registra un pago inicial en estado PENDING generado por otro microservicio (ej: Solicitudes/Sacramentos)."
					},
					"response": []
				},
				{
					"name": "Crear Pago por Venta de Libros",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"tenant_id\": 1,\n  \"persona_id\": 102,\n  \"amount\": 75.00,\n  \"items\": [\n    {\n      \"bookId\": 10,\n      \"quantity\": 2\n    },\n    {\n      \"bookId\": 15,\n      \"quantity\": 1\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/payments",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"payments"
							]
						},
						"description": "Registra un pago inicial para la compra de libros con detalle de ítems."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Operaciones de Finanzas (Completar)",
			"item": [
				{
					"name": "Completar Pago (Efectivo / Yape / Transferencia)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"metodo_pago\": \"EFECTIVO\",\n  \"reference\": \"REC-001234\",\n  \"confirmed_by\": 5\n}"
						},
						"url": {
							"raw": "{{base_url}}/payments/{{payment_id}}/complete",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"payments",
								"{{payment_id}}",
								"complete"
							]
						},
						"description": "Asigna el método de pago (EFECTIVO, YAPE, PLIN, TRANSFERENCIA), voucher/referencia y pasa el estado a COMPLETED."
					},
					"response": []
				}
			]
		},
