# Configuración de Entorno para vg-ms-paymentservice
SERVER_PORT=8086
SPRING_PROFILES_ACTIVE=dev

# Base de Datos R2DBC PostgreSQL
R2DBC_URL=r2dbc:postgresql://localhost:5432/payments_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Keycloak OAuth2
KEYCLOAK_ISSUER_URI=https://lab.vallegrande.edu.pe/keycloak-security/realms/prs-realm

# URLs de Microservicios Externos
BOOKS_SERVICE_URL=https://lab.vallegrande.edu.pe/fideiNexus-books/v1/books
REQUESTS_SERVICE_URL=https://lab.vallegrande.edu.pe/fideiNexus-solicitud/v1/requests
USERS_SERVICE_URL=http://localhost:8765/api/v1/users
